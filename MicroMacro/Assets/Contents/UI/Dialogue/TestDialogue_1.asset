  items:
  - EntryName: test_1
    Text: "\u3066\u3059\u3068"
    DisplayTime: 4
    characterIcon: {fileID: 21300000, guid: d111e31e399fbc647a0734b4f034dc86, type: 3}
  - EntryName: test_2
    Text: "\u3053\u308C\u306F\u30C6\u30B9\u30C82\u3067\u3059"
    DisplayTime: 3
    characterIcon: {fileID: 21300000, guid: ebe3e163ec9aaa74e851ba4a53d6a80d, type: 3}
  - EntryName: Mainlog1_1_0_1
    Text: "\u6D41\u77F3\u306B\u3053\u3053\u304B\u3089\u4E00\u6C17\u306B\u98DB\u3073\u964D\u308A\u308B\u306E\u306F\u5371\u967A\u3060\u306A\u3041\u2026"
    DisplayTime: 4
    characterIcon: {fileID: 21300000, guid: d111e31e399fbc647a0734b4f034dc86, type: 3}
  - EntryName: Mainlog1_1_0_2
    Text: "\u4F55\u3068\u304B\u8377\u7269\u3092\u3053\u3048\u3066\u9032\u307E\u306A\u3044\u3068"
    DisplayTime: 3.5
    characterIcon: {fileID: 21300000, guid: 3f052fdbde3cefe4abff7def72072b57, type: 3}
  - EntryName: Mainlog1_1_0_3
    Text: "\uFF08\u30D5\u30B0\uFF09\u30D5\u30C3\u30D5\u30C3\u30D5\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u305D\u3093\u306A\u3068\u304D\u306F\u30DC\u30AF\u306E\u7269\u3092\u5927\u304D\u304F\u3057\u305F\u308A\u5C0F\u3055\u304F\u3057\u305F\u308A\u51FA\u6765\u308B\u529B\u3092\u4F7F\u3046\u306E\u30B5"
    DisplayTime: 6
    characterIcon: {fileID: 21300000, guid: a2c15c25335ba424787e75a761da9195, type: 3}
  - EntryName: Mainlog1_1_1
    Text: "\u3055\u3063\u305D\u304F\u3053\u306E\u30D3\u30F3\u3092\u5C0F\u3055\u304F\u3057\u3066\u307F\u3088\u3046\uFF01"
    DisplayTime: 4
    characterIcon: {fileID: 21300000, guid: ddbba600a30db374bb30a40922e1bc85, type: 3}
  - EntryName: Mainlog1_1_2
    Text: "\u8DB3\u5143\u306E\u30AD\u30CE\u30B3\u304C\u5927\u304D\u3051\u308C\u3070\u306A\u3041\u2026"
    DisplayTime: 4
    characterIcon: {fileID: 21300000, guid: a2c15c25335ba424787e75a761da9195, type: 3}
  - EntryName: Mainlog1_1_3
    Text: "\u3075\u3080\u3075\u3080\u4E0A\u4E0B\u306B\u3082\u6483\u3066\u308B\u3093\u3060\u306D"
    DisplayTime: 4
    characterIcon: {fileID: 21300000, guid: ebe3e163ec9aaa74e851ba4a53d6a80d, type: 3}
  - EntryName: Mainlog1_1_4
    Text: "\u4E0A\u306B\u751F\u3048\u3066\u308B\u30ADw\u30CE\u30B3\u304C\u5927\u304D\u3059\u304E\u3066\u3000\u3000\u9053\u3092\u585E\u3044\u3067\u308B\u307F\u305F\u3044\u2026"
    DisplayTime: 4
    characterIcon: {fileID: 21300000, guid: a2c15c25335ba424787e75a761da9195, type: 3}
  - EntryName: Mainlog1_1_6
    Text: "\u672C\u3092\u5927\u304D\u304F\u3057\u305F\u885D\u6483\u3067\u98DB\u3073\u4E0A\u304C\u308C\u308B\u304B\u3082\uFF1F"
    DisplayTime: 3
    characterIcon: {fileID: 21300000, guid: a2c15c25335ba424787e75a761da9195, type: 3}
  - EntryName: Mainlog1_2_1
    Text: "\u5E8A\u306B\u5371\u967A\u305D\u3046\u306A\u3084\u3064\u3089\u304C\u751F\u3048\u3066\u308B\u2026"
    DisplayTime: 2.5
    characterIcon: {fileID: 21300000, guid: d111e31e399fbc647a0734b4f034dc86, type: 3}
  - EntryName: Mainlog1_2_2_1
    Text: "\u3046\u308F\u3063\uFF01\u30D3\u30F3\u304C\u30D5\u30BF\u3092\u98DB\u3070\u3057\u3066\u304F\u308B\u3088"
    DisplayTime: 3
    characterIcon: {fileID: 21300000, guid: d111e31e399fbc647a0734b4f034dc86, type: 3}
  - EntryName: Mainlog1_2_2_2
    Text: "\u4F55\u3060\u304B\u30D5\u30BF\u304C\u5F31\u70B9\u306A\u6C17\u304C\u3059\u308B\uFF01"
    DisplayTime: 3
    characterIcon: {fileID: 21300000, guid: ebe3e163ec9aaa74e851ba4a53d6a80d, type: 3}
  - EntryName: Mainlog1_2_3
    Text: "\u6C34\u98F2\u307F\u9CE5\u3092\u4F55\u304B\u3067\u56FA\u5B9A\u3067\u304D\u306A\u3044\u304B\u306A\uFF1F"
    DisplayTime: 3
    characterIcon: {fileID: 21300000, guid: a2c15c25335ba424787e75a761da9195, type: 3}
  - EntryName: Mainlog1_2_4
    Text: "\u3053\u3053\u306F\u6D41\u77F3\u306B\u30B8\u30E3\u30F3\u30D7\u3060\u3051\u3058\u3083\u8D8A\u3048\u3089\u308C\u305D\u3046\u306B\u306A\u3044\u306A\u3041\u2026"
    DisplayTime: 3
    characterIcon: {fileID: 21300000, guid: a2c15c25335ba424787e75a761da9195, type: 3}
  - EntryName: Mainlog1_2_5
    Text: "\u3042\u3068\u3061\u3087\u3063\u3068\u3067\u30E9\u30F3\u30BF\u30F3\u3092\u540A\u308B\u3057\u3066\u308B\u3000\u3000\u30ED\u30FC\u30D7\u304C\u5207\u308C\u305D\u3046\u3060\u2026"
    DisplayTime: 5
    characterIcon: {fileID: 21300000, guid: ebe3e163ec9aaa74e851ba4a53d6a80d, type: 3}
