  items:
  - EntryName: Boss_1_1
    Text: "\u3067\u3082\u3053\u306E\u30AB\u30FC\u30B4\u304C<r=\u3058\u3083\u307E>\u90AA\u9B54</r>\u3067\u3001\u3053\u306E\u307E\u307E\u3058\u3083<r=\u305D\u3068>\u5916</r>\u306B<r=\u3067>\u51FA</r>\u308C\u306A\u3044\u3084..."
    DisplayTime: 2.5
    isFuguDialogue: 0
  - EntryName: Boss_1_2
    Text: "\u3069\u3046\u306B\u304B\u3057\u3066<r=\u3046\u3054>\u52D5</r>\u304B\u305B\u306A\u3044\u304B\u306A\uFF1F"
    DisplayTime: 1
    isFuguDialogue: 0
  - EntryName: Boss_1_3
    Text: "\u30E4\u30D0\u3044\u30D5\uFF01\u3076\u3064\u3051\u3089\u308C\u3066<r=\u304A\u3053>\u6012</r>\u3063\u3066\u308B\u30D5\uFF01"
    DisplayTime: 1
    isFuguDialogue: 1
  - EntryName: Boss_1_4
    Text: "\u3055\u3063\u304D\u3068<r=\u304A\u306A>\u540C</r>\u3058\u3088\u3046\u306B\u3057\u3066<r=\u304D\u305C\u3064>\u6C17\u7D76</r>\u3055\u305B\u308B\u30D5\u3088!"
    DisplayTime: 1
    isFuguDialogue: 1
  - EntryName: Boss_Sv_1
    Text: "<r=\u3058\u3083\u307E>\u90AA\u9B54</r>\u306A\u3068\u3053\u308D\u3067<r=\u306D>\u5BDD</r>\u3066\u308B\u30D5\u306D\u3001\u3053\u306E\u307E\u307E\u3058\u3083<r=\u305D\u3068>\u5916</r>\u306B<r=\u3067>\u51FA</r>\u3089\u308C\u306A\u3044\u30D5\u3002"
    DisplayTime: 2.6
    isFuguDialogue: 1
  - EntryName: Boss_Sv_2
    Text: "\u3069\u3046\u306B\u304B\u3057\u3066\u8D77\u3053\u305B\u306A\u3044\u304B\u306A\u3002"
    DisplayTime: 1
    isFuguDialogue: 0
  - EntryName: Boss_Sv_3
    Text: "\u5BDD\u8D77\u304D\u3067\u6012\u3063\u3066\u308B\u30D5\u3002"
    DisplayTime: 1
    isFuguDialogue: 1
  - EntryName: Boss_Sv_4
    Text: "\u3055\u3063\u304D\u3068\u540C\u3058\u3088\u3046\u306B\u3057\u3066\u6C17\u7D76\u3055\u305B\u308B\u30D5\u3088"
    DisplayTime: 1
    isFuguDialogue: 1
  - EntryName: Boss_Start
    Text: "\u307E\u3060<r=\u3066\u3064\u3060>\u624B\u4F1D</r>\u3063\u3066\u307B\u3057\u3044\u3053\u3068\u304C\u3042\u308B\u30D5\uFF01<r=\u305D\u3068>\u5916</r>\u306B\u3080\u304B\u3046\u30D5\uFF01"
    DisplayTime: 1
    isFuguDialogue: 1
