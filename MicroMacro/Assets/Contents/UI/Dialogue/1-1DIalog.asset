  - EntryName: 1-1-5
    Text: "<r=\u304B\u304A>\u9854</r>\u304C\u3042\u308B<r=\u3088\u3046\u305B\u3044>\u5996\u7CBE</r>\u306F\u3001\u30DC\u30AF\u306E<r=\u3061\u304B\u3089>\u529B</r>\u3067<r=\u304A\u304A>\u5927</r>\u304D\u3055\u3092<r=\u304B>\u5909</r>\u3048\u3089\u308C\u308B\u30D5\uFF01"
    DisplayTime: 3
    isFuguDialogue: 1
  - EntryName: 1-1-6
    Text: "<r=\u3046\u3048>\u4E0A</r>\u3084<r=\u3057\u305F>\u4E0B</r>\u306B\u3082<r=\u3081>\u76EE</r>\u3092<r=\u3080>\u5411</r>\u3051\u308B\u3068\u3044\u3044\u30D5\u3002"
