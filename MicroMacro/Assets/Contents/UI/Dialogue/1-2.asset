    DisplayTime: 1.5
    isFuguDialogue: 0
  - EntryName: 1-2-5
    Text: "\u3082\u3046\u3059\u3053\u3057\u3067<r=\u304A>\u843D</r>\u3068\u305B\u305D\u3046..."
    DisplayTime: 2
    isFuguDialogue: 0
  - EntryName: 1-2-6
    Text: "\u30AB\u30D3\u3092<r=\u307F>\u898B</r>\u3064\u3051\u305F\u30D5\uFF01"
    DisplayTime: 1.5
    isFuguDialogue: 1
  - EntryName: 1-2-Start
