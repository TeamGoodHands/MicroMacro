  - EntryName: 1-2-1
    Text: "<r=\u3086\u304B>\u5E8A</r>\u306E\u30AB\u30D3\u306F<r=\u3051>\u6D88</r>\u305B\u306A\u3044\u30D5\u3002\u3042\u3076\u306A\u3044\u304B\u3089<r=\u304D>\u6C17</r>\u3092<r=\u3064>\u4ED8</r>\u3051\u308B\u30D5\u3002"
    DisplayTime: 2
    isFuguDialogue: 1
  - EntryName: 1-2-2
    Text: "\u30D5\u30BF\u3092<r=\u306A>\u6295</r>\u3052\u3066\u308B\uFF01<r=\u3042>\u5F53</r>\u305F\u308B\u3068<r=\u3044\u305F>\u75DB</r>\u305D\u3046\u3060\u306D\u2026"
    DisplayTime: 2.5
    isFuguDialogue: 0
  - EntryName: 1-2-3
    Text: "\u305D\u308C\u306F<r=\u3080>\u5411</r>\u3053\u3046\u3082<r=\u304A\u306A>\u540C</r>\u3058\u3053\u3068\u30D5\uFF01"
